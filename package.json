{
  "name": "chess-game-reviewer",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.17.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "verify:stockfish": "node scripts/stockfish/verify-artifacts.mjs",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "chess.js": "1.4.0",
    "next": "16.3.0",
    "react": "19.0.0",
    "react-chessboard": "5.12.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.2.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.13.4",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "fake-indexeddb": "6.0.0",
    "jsdom": "26.0.0",
    "prettier": "3.5.1",
    "typescript": "5.7.3",
    "vitest": "3.2.7"
  },
  "engines": {
    "node": ">=20.11.0"
  }
}
